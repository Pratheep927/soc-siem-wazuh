<group name="clouds,local,">

  <rule id="100020" level="5">
    <if_sid>31100,31101,31108</if_sid>
    <url>login.php</url>
    <description>CLOUDS: Tentative d authentification web sur DVWA</description>
    <group>web,accesslog,attack,</group>
  </rule>

  <rule id="100021" level="10" frequency="6" timeframe="60">
    <if_matched_sid>100020</if_matched_sid>
    <same_source_ip />
    <description>CLOUDS: Brute-force web DVWA detecte</description>
    <mitre><id>T1110.001</id></mitre>
    <group>web,attack,authentication_failures,</group>
  </rule>

  <rule id="100031" level="12">
    <if_sid>31100,31101,31103,31104,31106,31108,31164</if_sid>
    <regex type="pcre2">(?i)(union(\s|\+|%20)+select|or(\s|\+|%20)+1=1|sleep\(|information_schema)</regex>
    <description>CLOUDS: Injection SQL confirmee - niveau critique</description>
    <mitre><id>T1190</id></mitre>
    <group>web,attack,sql_injection,</group>
  </rule>
<!--
  ============================================================
  REGLES D'EXCLUSION DE FAUX POSITIFS
  ============================================================
  Principe : niveau 0 = Wazuh n'alerte pas. On ne supprime pas la
  détection, on l'affine pour qu'elle ne se déclenche pas sur du
  trafic légitime (healthcheck, supervision), tout en restant active
  contre une vraie attaque depuis une IP externe.
-->

  <!-- Healthcheck Docker local sur login.php : bruit, pas une menace -->
  <rule id="100090" level="0">
    <if_sid>100020</if_sid>
    <srcip>127.0.0.1</srcip>
    <url>login.php</url>
    <description>Faux positif: healthcheck local sur login.php - ignore</description>
  </rule>

  <!-- Endpoints de supervision (monitoring) : trafic attendu -->
  <rule id="100091" level="0">
    <if_sid>100020</if_sid>
    <url>/server-status|/health|/ping</url>
    <description>Faux positif: endpoint de supervision - ignore</description>
  </rule>

  <!-- Echec d'authentification isole : banal, seul le motif brute-force alerte -->
  <rule id="100092" level="0">
    <if_sid>100021</if_sid>
    <srcip>127.0.0.1</srcip>
    <description>Faux positif: échec d'auth local isolé - ignore</description>
  </rule>

</group>
